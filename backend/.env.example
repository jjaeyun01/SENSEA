# .env로 복사한 뒤 키와 토큰을 입력하세요. 실제 .env는 Git에 올리지 않습니다.
# backend 폴더에서 실행:
# uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --env-file .env

# 실제 도보 경로 — 필수
# Google Routes API 서버용 키. 모바일 지도 표시 키와 구분하세요.
GOOGLE_ROUTES_API_KEY=
# 직접 생성한 긴 랜덤 토큰. mobile의 EXPO_PUBLIC_API_TOKEN과 동일한 값.
# 경로 요청, 서버 음성 전사 및 소음 쓰기 인증에 사용합니다.
SENSEA_WRITE_TOKEN=

# 서버 음성 전사 — 사용할 때만 필요
# 모바일 기기 내 카메라 분석과 OS 음성 인식에는 OpenAI 키가 필요하지 않습니다.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# 서버의 가상 경로·소음 데이터 — 기본값 유지
SENSEA_DB_PATH=./sensea.sqlite3
# 가상 캠퍼스 그래프입니다. 실제 경로는 Google Routes API를 사용합니다.
SENSEA_GRAPH_PATH=./data/demo-campus.json
# 사용자 현지 시각이 없는 자동 소음 정책 요청의 기본 시간대.
SENSEA_TIMEZONE=America/Chicago

# 수동으로 검증한 출입구 데이터 — 기본 파일은 비어 있음
SENSEA_ENTRANCES_PATH=./data/entrances.json

# 별도 사진 분석 서버 (uvicorn app.foundation:app) — 현재 앱에서는 선택 사항
# 휴대폰 카메라는 기기 내 분석을 사용하므로 disabled를 유지해도 됩니다.
# 서버 사진 분석을 사용하려면 openai로 변경하고 OPENAI_API_KEY를 입력하세요.
VISION_PROVIDER=disabled
OPENAI_VISION_MODEL=gpt-4.1-mini
# openai 모드에서 필수인 별도 접근 토큰. X-API-Key 헤더로 전달합니다.
SENSEA_API_KEY=

# foundation 서버 사진 분석·요청 제한 — 기본값 유지
VISION_TIMEOUT_SECONDS=15
VISION_REQUESTS_PER_MINUTE=6
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
MAX_CONCURRENT_UPLOADS=2
# 요청 본문 수신 제한시간. AI 응답 제한시간과 별개입니다.
REQUEST_BODY_TIMEOUT_SECONDS=15
# 일반 요청 본문 크기. 사진 업로드는 MAX_IMAGE_BYTES + multipart 여유분 적용.
MAX_REQUEST_BYTES=65536

# foundation 서버의 가상 소음·경로 설정 — 기본값 유지
NOISE_TTL_SECONDS=3600
NOISE_CLEANUP_INTERVAL_SECONDS=60
# 검토 정보의 유효기간이며 실제 보행 안전을 보장하지 않습니다.
PATH_VERIFICATION_TTL_SECONDS=86400
# 브라우저 접근을 허용할 경우 JSON 배열로 지정. 네이티브 앱은 기본값 사용.
CORS_ORIGINS=[]

# 서버 사진 품질 검사 기준 — 실기기·장면별 보정이 필요한 초기값
QUALITY_MIN_SHORT_SIDE=192
QUALITY_CLIP_FRACTION=0.85
QUALITY_MIN_EDGE_MEAN=1.5

# 현재 백엔드는 Supabase 저장소 어댑터를 사용하지 않습니다.
# Supabase 키·DB 비밀번호·연결 문자열은 이 파일에 추가할 필요가 없습니다.
