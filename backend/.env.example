# Copy to .env. Never commit real keys.

# Speech and route API (uvicorn app.main:app)
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Required bearer token for transcription and noise writes. Choose a random value.
SENSEA_WRITE_TOKEN=
SENSEA_DB_PATH=./sensea.sqlite3
# Replace only after surveying actual pedestrian paths.
SENSEA_GRAPH_PATH=./data/demo-campus.json

# Camera foundation API (uvicorn app.foundation:app)
# The default is a synthetic, in-memory simulation.
VISION_PROVIDER=disabled
OPENAI_VISION_MODEL=gpt-4.1-mini
# Required for openai mode; generate a random prototype API access token.
SENSEA_API_KEY=
VISION_TIMEOUT_SECONDS=15
VISION_REQUESTS_PER_MINUTE=6
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
NOISE_TTL_SECONDS=3600
NOISE_CLEANUP_INTERVAL_SECONDS=60
# Provisional review freshness, not a guarantee of route safety.
PATH_VERIFICATION_TTL_SECONDS=86400
MAX_CONCURRENT_UPLOADS=2
CORS_ORIGINS=[]

# Provisional photo-quality heuristics; require device/scene calibration.
QUALITY_MIN_SHORT_SIDE=192
QUALITY_CLIP_FRACTION=0.85
QUALITY_MIN_EDGE_MEAN=1.5
