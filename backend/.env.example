# Run from backend/. The default is a synthetic, in-memory simulation.
VISION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Required for openai or supabase mode; generate a random prototype API access token.
SENSEA_API_KEY=
VISION_TIMEOUT_SECONDS=15
VISION_REQUESTS_PER_MINUTE=6
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
NOISE_TTL_SECONDS=3600
CORS_ORIGINS=[]

# Provisional photo-quality heuristics; require device/scene calibration.
QUALITY_MIN_SHORT_SIDE=192
QUALITY_CLIP_FRACTION=0.85
QUALITY_MIN_EDGE_MEAN=1.5

# Storage is independent of vision and simulation. No DB access in memory mode.
STORAGE_BACKEND=memory
# Example project origin: https://your-project.supabase.co
SUPABASE_URL=
# Server only: sb_secret_... or legacy service_role key; never put this in mobile.
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=10
# Leave true until real graph data has been independently reviewed.
SUPABASE_SIMULATION_ONLY=true
