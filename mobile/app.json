{
  "expo": {
    "name": "SENSEA",
    "slug": "sensea",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sensea",
    "ios": {
      "bundleIdentifier": "com.sensea.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "주변 사물을 기기에서 분석하고 음성으로 알려드리기 위해 카메라를 사용합니다."
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.sensea.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SENSEA uses your location for in-app walking guidance.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SENSEA uses your microphone for voice commands and continuous on-device environmental sound measurement while the app is open. Sound measurements are not stored or uploaded.",
          "speechRecognitionPermission": "SENSEA converts speech into destination and navigation commands."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SENSEA measures device-relative environmental sound while the app is open. Audio is processed on this device and is not stored or uploaded.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      "expo-router"
    ]
  }
}
