# Physical phones: use your server's LAN address. HTTPS is required in production.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Prototype access token; matches backend SENSEA_WRITE_TOKEN. Public app config,
# not a production secret. Replace with per-user authentication before distribution.
EXPO_PUBLIC_API_TOKEN=
# Native map display (separate restricted SDK keys; never put Routes key here).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
