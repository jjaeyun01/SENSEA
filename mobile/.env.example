# .env로 복사한 뒤 주소와 키를 입력하세요. 실제 .env는 Git에 올리지 않습니다.
# EXPO_PUBLIC_* 값은 앱에 포함됩니다. 서버 비밀키나 DB 비밀번호를 넣지 마세요.

# 백엔드 주소
# 실제 휴대폰에서는 localhost 대신 개발 컴퓨터의 LAN IP로 변경하세요.
# 예: http://192.168.1.100:8000 — 실제 배포에서는 HTTPS 주소 사용.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# backend의 SENSEA_WRITE_TOKEN과 정확히 같은 값.
# 앱에 포함되는 프로토타입 토큰이며, 배포 전 사용자 인증으로 대체해야 합니다.
EXPO_PUBLIC_API_TOKEN=

# 지도 표시용 플랫폼별 Google 키 — Routes 서버 키와 구분
# Maps SDK for Android용 키. 앱 패키지/서명 제한을 적용하세요.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Maps SDK for iOS용 키. 앱 번들 ID 제한을 적용하세요.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Supabase 프로젝트 연결 — 팀이 동일한 프로젝트 URL과 공개용 키 사용
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable 키를 사용하세요. 데이터 접근은 DB의 RLS 정책으로 제어합니다.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OPENAI_API_KEY, GOOGLE_ROUTES_API_KEY, Supabase service_role/secret 키,
# DB 비밀번호는 모바일 환경변수에 넣지 않습니다.
# 이전 이름 EXPO_PUBLIC_API_URL 대신 EXPO_PUBLIC_API_BASE_URL을 사용하세요.
# 값 변경 후 개발 서버 재시작. 지도 SDK 키 변경 시 네이티브 앱 재빌드.
